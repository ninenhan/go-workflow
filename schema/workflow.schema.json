{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninenhan.github.io/go-workflow/schema/workflow.schema.json",
  "title": "WorkflowDefinition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "fail_fast": {
      "type": "boolean"
    },
    "entry_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trigger"
      }
    },
    "publish_config": {
      "$ref": "#/$defs/publishConfig"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "name",
    "nodes"
  ],
  "$defs": {
    "duration": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "executorSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "http",
            "local_go",
            "python",
            "node",
            "queue",
            "remote",
            "container",
            "unit"
          ]
        },
        "ref": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "type"
      ]
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "backoff": {
          "$ref": "#/$defs/duration"
        },
        "max_backoff": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "loopPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "condition": {
          "type": "string"
        }
      }
    },
    "branchPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "all",
            "first"
          ]
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "node",
            "var",
            "request",
            "run"
          ]
        },
        "path": {
          "type": "string"
        },
        "as": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "transform": {
          "type": "string"
        }
      },
      "required": [
        "from"
      ]
    },
    "inputSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "replace",
            "object",
            "array"
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputBinding"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "task",
            "parallel_gateway"
          ]
        },
        "executor": {
          "$ref": "#/$defs/executorSpec"
        },
        "input": {},
        "input_spec": {
          "$ref": "#/$defs/inputSpec"
        },
        "params": {
          "type": "object"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry": {
          "$ref": "#/$defs/retryPolicy"
        },
        "loop": {
          "$ref": "#/$defs/loopPolicy"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "branch": {
          "$ref": "#/$defs/branchPolicy"
        },
        "disabled": {
          "type": "boolean"
        },
        "ui": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "parallel_gateway"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["executor"] },
                { "required": ["input"] },
                { "required": ["input_spec"] },
                { "required": ["params"] },
                { "required": ["depends_on"] },
                { "required": ["retry"] },
                { "required": ["loop"] },
                { "required": ["timeout"] },
                { "required": ["branch"] },
                { "required": ["disabled"] }
              ]
            }
          },
          "else": {
            "required": [
              "executor"
            ]
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "normal",
            "back"
          ]
        },
        "condition": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "manual",
            "http",
            "cron"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type"
      ]
    },
    "publishConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "route": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "auth_required": {
          "type": "boolean"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        }
      }
    }
  }
}
